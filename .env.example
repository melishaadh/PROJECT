# Copy to .env before `docker compose up`.

MONGO_DB_NAME=trekeasy

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

NODE_ENV=production
PORT=3001
# The origin the browser loads the app from (the nginx service, port 80).
# Required with NODE_ENV=production: an empty value refuses every cross-origin
# request and breaks the chat socket handshake. Comma-separate multiple hosts.
CORS_ORIGINS=http://localhost
TRUST_PROXY=true

# Baked into the frontend build at build time.
EXPO_PUBLIC_API_URL=/api

# Optional — unset, uploads fall back to local disk (backend-uploads volume).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
