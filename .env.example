# Copy to `.env` and fill in before `docker compose up`. `.env` itself is
# git-ignored. Values here are read by docker-compose.yml directly and passed
# through to the `backend` container via `env_file:`.

# ── Database ───────────────────────────────────────────────────────────────
# Compose builds the URI itself from this name (mongo:27017/<name>) — see
# docker-compose.yml. Only the database name is needed here; MONGODB_URI in
# backend/.env.example is for running the backend outside Compose.
MONGO_DB_NAME=trekeasy

# ── Auth ───────────────────────────────────────────────────────────────────
# Two distinct random strings, each >= 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
# Blank because the browser only ever talks to the nginx origin (same-origin
# via /api), never directly to `backend` — see deploy/nginx/nginx.conf.
CORS_ORIGINS=
TRUST_PROXY=true

# ── Frontend build-time API URL ─────────────────────────────────────────────
# Baked into the Expo web bundle at build time (see frontend/Dockerfile) — a
# relative path works because nginx serves both the app and /api from the same
# origin.
EXPO_PUBLIC_API_URL=/api

# ── Uploads (optional) ───────────────────────────────────────────────────────
# All three unset ⇒ profile pictures are written to the `backend-uploads`
# named volume instead of Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PUBLIC_BASE_URL=
