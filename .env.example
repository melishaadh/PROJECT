# Copy to .env before `docker compose up`.

MONGO_DB_NAME=trekeasy

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Host port the proxy publishes — the stack's only public entrance. Change it
# here, never in docker-compose.yml, if something else on the VM owns 80.
# Jenkins on 8080 is NOT a conflict: the frontend's 8080 is container-internal
# and never published. If you do change this, add the new port to CORS_ORIGINS
# below, because the browser's origin changes with it.
HTTP_PORT=80

# Backend, published on 127.0.0.1 only, for on-VM debugging:
#   curl http://127.0.0.1:3001/api/health
# Deliberately not reachable from the LAN — browser traffic goes via the proxy.
BACKEND_DEBUG_PORT=3001

NODE_ENV=production
PORT=3001
# The origin the browser loads the app from (the nginx service, port 80).
# Required with NODE_ENV=production: an empty value refuses every cross-origin
# request and breaks the chat socket handshake. Comma-separate multiple hosts —
# add the LAN/VM address too if you reach the app by IP, e.g.
#   CORS_ORIGINS=http://localhost,http://192.168.1.50
CORS_ORIGINS=http://localhost
TRUST_PROXY=true

# Baked into the frontend build at build time.
EXPO_PUBLIC_API_URL=/api

# Optional — unset, uploads fall back to local disk (backend-uploads volume).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
