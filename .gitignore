# Root .gitignore for the whole monorepo (frontend/, backend/, backend-database/).
# Each service also carries its own, narrower .gitignore for anything specific
# to its own build.

# dependencies
node_modules/

# env — real secrets. `.env.example` files are committed as templates.
.env
.env.local
.env.*.local

# logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# backups / caches
*.bak
*.tmp
__pycache__/
*.pyc

# typescript
*.tsbuildinfo

# build output
dist/
build/
coverage/

# expo (frontend/)
frontend/.expo/
frontend/web-build/
frontend/expo-env.d.ts

# native (frontend/)
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
frontend/.metro-health-check*

# Native projects generated by `expo prebuild` for the Detox build. Regenerate
# rather than commit — see frontend/e2e/README.md.
frontend/android/
frontend/ios/

# Detox artifacts: device logs, screenshots and view hierarchies. The suite
# itself writes no run report — see frontend/e2e/support/reporter.ts, which
# streams to the console only — so nothing here carries user data beyond what a
# screenshot of the app shows.
frontend/artifacts/

# Locally-stored profile picture uploads (development fallback only — in
# production these live in Cloudinary; see backend/src/common/storage.service.ts).
backend/uploads/

# Docker / Kubernetes local state
.docker/
*.kubeconfig

# os
.DS_Store
*.pem
Thumbs.db
