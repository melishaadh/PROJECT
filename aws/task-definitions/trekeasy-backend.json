{
  "//": "Standalone copy of the backend task definition (the CloudFormation stack 03-services.yaml is the source of truth). Register with: aws ecs register-task-definition --cli-input-json file://aws/task-definitions/trekeasy-backend.json  — after replacing <ACCOUNT_ID>, <REGION>, and <IMAGE_TAG>.",
  "family": "trekeasy-backend",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/trekeasy-ecs-execution",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/trekeasy-ecs-task",
  "volumes": [
    {
      "name": "uploads",
      "efsVolumeConfiguration": {
        "fileSystemId": "<EFS_FILE_SYSTEM_ID>",
        "transitEncryption": "ENABLED",
        "authorizationConfig": { "accessPointId": "<UPLOADS_ACCESS_POINT_ID>", "iam": "DISABLED" }
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "trekeasy-backend",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/trekeasy-backend:<IMAGE_TAG>",
      "essential": true,
      "portMappings": [{ "containerPort": 3001, "protocol": "tcp" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3001" },
        { "name": "TRUST_PROXY", "value": "true" },
        { "name": "MONGODB_URI", "value": "mongodb://mongo.trekeasy.local:27017/trekeasy" },
        { "name": "CORS_ORIGINS", "value": "http://<ALB_DNS_NAME>" },
        { "name": "PUBLIC_BASE_URL", "value": "http://<ALB_DNS_NAME>" }
      ],
      "secrets": [
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:trekeasy/jwt:JWT_SECRET::" },
        { "name": "JWT_REFRESH_SECRET", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:trekeasy/jwt:JWT_REFRESH_SECRET::" }
      ],
      "mountPoints": [{ "sourceVolume": "uploads", "containerPath": "/app/backend/uploads" }],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q -O- http://127.0.0.1:3001/api/health | grep -q '\"status\":\"ok\"' || exit 1"],
        "interval": 30, "timeout": 5, "retries": 3, "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/trekeasy-backend",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "backend"
        }
      }
    }
  ]
}
