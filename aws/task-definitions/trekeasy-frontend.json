{
  "//": "Standalone copy of the frontend task definition (source of truth: aws/cloudformation/03-services.yaml). Register with: aws ecs register-task-definition --cli-input-json file://aws/task-definitions/trekeasy-frontend.json",
  "family": "trekeasy-frontend",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/trekeasy-ecs-execution",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/trekeasy-ecs-task",
  "containerDefinitions": [
    {
      "name": "trekeasy-frontend",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/trekeasy-frontend:<IMAGE_TAG>",
      "essential": true,
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1"],
        "interval": 30, "timeout": 5, "retries": 3, "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/trekeasy-frontend",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ]
}
