# Copy to `.env` and fill in. `.env` itself is git-ignored — never commit real
# credentials.

# ── Database ───────────────────────────────────────────────────────────────
# In Docker Compose / Kubernetes this points at the `mongo` service; Atlas
# rejects connections from IPs not on the cluster's access list if you use it
# instead — add your current IP under Atlas → Network Access if boot reports a
# selection timeout.
MONGODB_URI=mongodb://localhost:27017/trekeasy

# ── Auth ───────────────────────────────────────────────────────────────────
# Two distinct random strings, each >= 32 characters. Boot fails in production
# if either is missing; in development a well-known fallback is used and warned
# about. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Keep the access token short — it is unrevocable for its lifetime. Session
# longevity comes from the refresh token, which is revocable.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Comma-separated origins allowed to send credentialed requests. Blank in
# development (the caller is reflected); REQUIRED in production.
CORS_ORIGINS=

# "true" only behind a reverse proxy, so rate limiting keys on the real client IP.
TRUST_PROXY=false

# ── Uploads (optional) ─────────────────────────────────────────────────────
# All three unset ⇒ profile pictures are written to backend/uploads/ on local
# disk, which does not survive a redeploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PUBLIC_BASE_URL=
