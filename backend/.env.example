# Copy to .env for local (non-Docker) development.

MONGODB_URI=mongodb://localhost:27017/trekeasy

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

PORT=3001
NODE_ENV=development
CORS_ORIGINS=
TRUST_PROXY=false

# Optional — unset, uploads are written to backend/uploads/ on local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PUBLIC_BASE_URL=
