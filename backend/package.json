{
  "name": "trekeasy-backend",
  "version": "1.0.0",
  "description": "TrekEasy NestJS Backend with MongoDB Atlas",
  "author": "TrekEasy Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/backend/src/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "seed:destinations": "ts-node -r tsconfig-paths/register src/scripts/seed-destinations.ts",
    "migrate:age-brackets": "ts-node -r tsconfig-paths/register src/scripts/migrate-age-brackets.ts",
    "seed:test-users": "ts-node -r tsconfig-paths/register src/scripts/enrich-test-users.ts",
    "seed:demo-chats": "ts-node -r tsconfig-paths/register src/scripts/seed-demo-chats.ts",
    "explain:feed": "ts-node -r tsconfig-paths/register src/scripts/explain-feed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@xenova/transformers": "^2.17.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "module-alias": "^2.3.4",
    "mongoose": "^8.9.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "//": "Schemas under ../../backend-database resolve their node_modules by walking up from their own directory, which never reaches backend/node_modules. Same reason the tsconfig maps @nestjs/* and mongoose explicitly.",
    "modulePaths": [
      "<rootDir>/../node_modules"
    ],
    "moduleNameMapper": {
      "^@db/(.*)$": "<rootDir>/../../backend-database/$1",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
