# Expo web export, served as a static site on port 8080.
#   docker build -f frontend/Dockerfile -t trekeasy-frontend frontend
#
# EXPO_PUBLIC_API_URL is baked into the bundle at build time (Expo/Metro
# inlines process.env.EXPO_PUBLIC_* on export) — pass it as --build-arg. It has
# to be a build arg and not a runtime env var: by the time the container starts,
# the value is already a string literal inside the bundle.

FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

ARG EXPO_PUBLIC_API_URL=/api
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL
RUN npx expo export --platform web --output-dir dist

# Fail the build here rather than shipping an image that 404s at runtime: if the
# export produced no index.html or no entry bundle, there is nothing to serve.
RUN test -f dist/index.html \
 && ls dist/_expo/static/js/web/*.js >/dev/null

FROM nginx:alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html

# The serving rules live in frontend/nginx.conf as a real file. They used to be
# generated by a single-line `printf` in this Dockerfile, which was both
# unreviewable and one stray quote away from silently emitting a broken config.
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN nginx -t

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
